<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- dotnet publish makes a single native executable; the tool classes are trim- and AOT-safe. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package carries the source generator for [Tool], [Resource] and [Prompt]. -->
    <PackageReference Include="RecursiveAI.OneModelContext" Version="LIBRARY_VERSION" />
  </ItemGroup>

</Project>
