<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- Coverage instrumentation for the fuzz harness only. -->
    <PackageVersion Include="SharpFuzz" Version="2.2.0" />
  </ItemGroup>
  <!-- The one package each adapter adapts. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
  </ItemGroup>
  <!-- Tests only: the provider the EF stores are exercised against. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
  </ItemGroup>
  <!-- Samples and tests only: the generic host implementation, and the MEAI function-calling chat client. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
  </ItemGroup>
  <!-- Roslyn, build time only, for the source generator. 4.8 is the compiler of the .NET 8 SDK; a generator built
       against it loads in every later compiler. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
</Project>
