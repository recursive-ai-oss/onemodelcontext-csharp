<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>onemodelcontext</AssemblyName>
    <RootNamespace>RecursiveAI.OneModelContext.Cli</RootNamespace>
    <PackageId>$(PackagePrefix).OneModelContext.Cli</PackageId>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>onemodelcontext</ToolCommandName>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>The onemodelcontext command line tool for OneModelContext: a .NET SDK for the Model Context Protocol®. Pre-release; unpublished.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RecursiveAI.OneModelContext/RecursiveAI.OneModelContext.csproj" />
  </ItemGroup>

</Project>
