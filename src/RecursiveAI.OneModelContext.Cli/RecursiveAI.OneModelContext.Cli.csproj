<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>onemodelcontext</AssemblyName>
    <RootNamespace>RecursiveAI.OneModelContext.Cli</RootNamespace>
    <PackageId>$(PackagePrefix).OneModelContext.Cli</PackageId>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>onemodelcontext</ToolCommandName>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>The onemodelcontext command line tool for OneModelContext: a .NET SDK for the Model Context Protocol®. Model Context Protocol® is a registered trademark of LF Projects, LLC; OneModelContext is independent and not affiliated with or endorsed by LF Projects, LLC or the Model Context Protocol project.</Description>
  </PropertyGroup>

  <!-- Pass -p:SmokeMode=aot to publish a native executable. It is a project property, not PublishAot itself, because a global
       property would flow into the generator project, which cannot be published natively. -->
  <PropertyGroup Condition="'$(SmokeMode)' == 'aot'">
    <PublishAot>true</PublishAot>
    <PackAsTool>false</PackAsTool>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RecursiveAI.OneModelContext.CliTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RecursiveAI.OneModelContext/RecursiveAI.OneModelContext.csproj" />
  </ItemGroup>

</Project>
