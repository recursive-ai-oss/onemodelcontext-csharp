<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>$(PackagePrefix).OneModelContext.AspNetCore</AssemblyName>
    <RootNamespace>RecursiveAI.OneModelContext.AspNetCore</RootNamespace>
    <PackageId>$(PackagePrefix).OneModelContext.AspNetCore</PackageId>
    <IsPackable>true</IsPackable>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>ASP.NET Core hosting for OneModelContext: a .NET SDK for the Model Context Protocol®. MapModelContext serves the Streamable HTTP endpoint, on both protocol eras, through the host's own pipeline (authentication, rate limiting, CORS, logging). Model Context Protocol® is a registered trademark of LF Projects, LLC; OneModelContext is independent and not affiliated with or endorsed by LF Projects, LLC or the Model Context Protocol project.</Description>
  </PropertyGroup>

  <!-- The adapter's only dependencies are the core package and the ASP.NET Core shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../RecursiveAI.OneModelContext/RecursiveAI.OneModelContext.csproj" />
  </ItemGroup>

</Project>
