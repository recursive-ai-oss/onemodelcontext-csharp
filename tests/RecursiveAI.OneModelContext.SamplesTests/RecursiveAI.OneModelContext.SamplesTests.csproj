<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs each consumer sample end to end: in memory, over a Unix socket and as a child process. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RecursiveAI.OneModelContext.SamplesTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RecursiveAI.OneModelContext/RecursiveAI.OneModelContext.csproj" />
    <ProjectReference Include="../../samples/IndexedSearch/RecursiveAI.OneModelContext.Samples.IndexedSearch.csproj" />
    <ProjectReference Include="../../samples/LiveControl/RecursiveAI.OneModelContext.Samples.LiveControl.csproj" />
    <ProjectReference Include="../../samples/ToolBridge/RecursiveAI.OneModelContext.Samples.ToolBridge.csproj" />
    <ProjectReference Include="../../samples/Explorer/RecursiveAI.OneModelContext.Samples.Explorer.csproj" />
    <ProjectReference Include="../../samples/QuickPath/RecursiveAI.OneModelContext.Samples.QuickPath.csproj" />
    <ProjectReference Include="../../samples/AppsServer/RecursiveAI.OneModelContext.Samples.AppsServer.csproj" />
    <ProjectReference Include="../../samples/ProtectedServer/RecursiveAI.OneModelContext.Samples.ProtectedServer.csproj" />
    <ProjectReference Include="../../samples/HttpServer/RecursiveAI.OneModelContext.Samples.HttpServer.csproj" />
    <ProjectReference Include="../../src/RecursiveAI.OneModelContext.Hosting/RecursiveAI.OneModelContext.Hosting.csproj" />
    <ProjectReference Include="../../src/RecursiveAI.OneModelContext.Generator/RecursiveAI.OneModelContext.Generator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md;../../PACKAGE.md;../../docs/*.md" Link="Documentation/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
