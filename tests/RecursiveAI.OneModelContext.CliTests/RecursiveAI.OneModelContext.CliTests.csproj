<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the command line tool in process against child-process servers. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RecursiveAI.OneModelContext.CliTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RecursiveAI.OneModelContext.Cli/RecursiveAI.OneModelContext.Cli.csproj" />
    <ProjectReference Include="../RecursiveAI.OneModelContext.TestServer/RecursiveAI.OneModelContext.TestServer.csproj" ReferenceOutputAssembly="false" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TestServerDll</_Parameter1>
      <_Parameter2>$(ArtifactsPath)/bin/RecursiveAI.OneModelContext.TestServer/$(Configuration.ToLowerInvariant())/RecursiveAI.OneModelContext.TestServer.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
