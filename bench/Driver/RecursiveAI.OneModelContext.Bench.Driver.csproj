<Project Sdk="Microsoft.NET.Sdk">

  <!-- Coordinates the rows. It references no protocol stack: it starts the two bench apps as processes and, for the HTTP row, sends raw requests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>bench-driver</AssemblyName>
    <RootNamespace>Bench</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
